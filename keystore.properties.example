# 배포용 서명 키 설정의 예시입니다. 이 파일을 keystore.properties 로 복사해서 채우세요.
# keystore.properties 와 .jks 파일은 저장소에 올리지 않습니다(.gitignore).
#
# 키 만들기:
#   keytool -genkeypair -keystore ~/keystores/todolock-upload.jks \
#           -alias todolock-upload -keyalg RSA -keysize 4096 -validity 10000
#
# 이 파일이 없으면 release 도 debug 키로 서명됩니다. 빌드는 되지만 배포하면 안 됩니다 —
# debug 키는 비밀번호가 공개된 표준 키라 누구나 같은 서명의 '업데이트' 를 만들 수 있습니다.

storeFile=C:\\Users\\<사용자>\\keystores\\todolock-upload.jks
storePassword=<키스토어 비밀번호>
keyAlias=todolock-upload
keyPassword=<키 비밀번호>
