    <string name="wd_wed">Wed</string>
    <string name="wd_thu">Thu</string>
    <string name="wd_fri">Fri</string>
    <string name="wd_sat">Sat</string>

    <!-- ===== Date and time formats =====
         Patterns for SimpleDateFormat. Translators reorder the parts; they must
         not translate the pattern letters themselves (M, d, E, y, H, m). -->
    <string name="fmt_date">MMM d (E)</string>
    <string name="fmt_month">MMMM yyyy</string>
    <string name="fmt_month_short">MMM</string>
    <string name="fmt_time">HH:mm</string>
    <string name="fmt_time_12">h:mm a</string>

    <!-- "Today · Aug 5 (Wed)" -->
    <string name="date_today">Today · %1$s</string>
    <string name="date_tomorrow">Tomorrow · %1$s</string>
    <string name="date_yesterday">Yesterday · %1$s</string>

