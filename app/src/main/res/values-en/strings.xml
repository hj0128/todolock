<?xml version="1.0" encoding="utf-8"?>
<!--
    영어 문구. 기본값(한국어)은 values 에 있습니다.

    앱 이름(app_name)은 여기 두지 않습니다 — 어느 언어에서나 TodoLock 이라
    기본값 그대로 쓰면 됩니다. 없는 값은 기본값에서 가져옵니다.
-->
<resources>
    <!--
        앱 이름이 TodoLock 이므로 안에서도 'to-do' 로 부릅니다. task 와 섞어 쓰면
        같은 것을 두 이름으로 부르게 됩니다. 프로그래머식 'todo' 가 아니라
        영어 맞춤법대로 'to-do' 입니다.
    -->
    <string name="widget_name">To-do</string>
    <string name="widget_desc">See your to-dos on the home screen and tap to complete them</string>

    <!-- ===== Shared ===== -->
    <string name="ok">OK</string>
    <string name="cancel">Cancel</string>
    <string name="close">Close</string>
    <string name="done">Done</string>
    <string name="today">Today</string>
    <string name="cd_back">Back</string>

    <!-- Weekday headers. Used by both the in-app calendar and the widget, so
         they have to stay short enough for a narrow widget column. -->
