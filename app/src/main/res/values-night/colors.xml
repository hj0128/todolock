<?xml version="1.0" encoding="utf-8"?>
<!--
  다크 모드 대체값. 이름이 같으므로 values/themes.xml 의 스타일이 그대로 이걸 씁니다.
  어두운 배경에서는 파스텔 하늘색(#B3E5FC)이 그대로 쓰이면 눈부시므로,
  같은 계열의 깊은 하늘색으로 낮추고 글자를 연한 하늘색으로 얹습니다.
-->
<resources>
    <color name="sky_bright">#31768F</color>
    <color name="on_sky_bright">#C4E8F7</color>

    <!-- 강조색 팔레트(다크). 라이트와 같은 이름이라 테마 오버레이가 그대로 따라옵니다. -->
    <color name="sky_panel">#1A2226</color>

    <color name="green_bright">#35714A</color>
    <color name="on_green_bright">#C6EFD1</color>
    <color name="green_stroke">#5C9A6E</color>
    <color name="green_heading">#7FCB92</color>
    <color name="green_panel">#19221C</color>

    <color name="purple_bright">#55458C</color>
    <color name="on_purple_bright">#DDD2F7</color>
    <color name="purple_stroke">#7C6BB0</color>
    <color name="purple_heading">#B7A6EC</color>
    <color name="purple_panel">#1E1A26</color>

    <color name="orange_bright">#8A5A24</color>
    <color name="on_orange_bright">#FBE0C2</color>
    <color name="orange_stroke">#B0824B</color>
    <color name="orange_heading">#EFB877</color>
    <color name="orange_panel">#241E18</color>

    <color name="sky_stroke">#568DA6</color>

    <!-- '잠깐!' — 어두운 카드 위에서 과하지 않게 밝은 하늘색 -->
    <color name="sky_heading">#79C6E9</color>

    <!-- 어두운 배경에서는 붉은색이 더 강하게 보여 한 톤 더 눕힙니다 -->
    <color name="overdue">#E0928C</color>

    <color name="popup_item_bg">#2A363E</color>

    <color name="widget_bg">#1A2226</color>
    <color name="widget_text">#C9D4DA</color>
    <color name="widget_text_dim">#9FB0B9</color>
</resources>
