<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:rippleColor="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"><!--
          카드 터치를 여기서 소비합니다. 그러지 않으면 아래 스크림이 받아 닫힙니다.
        -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="위젯 설정"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="불투명도"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/slOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:valueFrom="20"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/tvOpacity"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="글꼴 크기"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!--
              3단계(작게·보통·크게) 대신 슬라이더입니다. 제목 크기만 고르면
              아랫줄과 헤더는 비율로 따라갑니다. 움직이는 동안 뒤의 위젯이 바로
              바뀌므로, 눈으로 보면서 원하는 크기에 세울 수 있습니다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/slFont"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="0.5"
                    android:valueFrom="11"
                    android:valueTo="24" />

                <TextView
                    android:id="@+id/tvFont"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.TodoLock.Button.Sky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="완료" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
