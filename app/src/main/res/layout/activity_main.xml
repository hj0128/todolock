<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenAdd"
        style="@style/Widget.TodoLock.Button.Sky"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="＋ 할 일 추가" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:alpha="0.55"
        android:text="할 일이 없습니다.\n오늘 할 일이 없으면 잠금해제 시 팝업도 뜨지 않아요."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="잠금해제하면 오늘 할 일 띄우기"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbAlways"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="매번" />

                <RadioButton
                    android:id="@+id/rbHourly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="1시간마다" />

                <RadioButton
                    android:id="@+id/rbOnce"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="하루 1번" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="미리 알림 방식"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <RadioGroup
                android:id="@+id/rgRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbShade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="알림창" />

                <RadioButton
                    android:id="@+id/rbHeadsUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="헤드업" />

                <RadioButton
                    android:id="@+id/rbPopup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="전체 팝업" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvPermWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorError"
                android:layout_marginTop="4dp"
                android:text="⚠ '다른 앱 위에 표시' 권한이 없으면 팝업 대신 알림으로만 표시됩니다."
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:textSize="11sp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="권한 주기" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="배터리 예외" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTest"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="미리보기" />
            </LinearLayout>

            <!--
              상단에 상시 표시되는 서비스 알림을 숨기러 가는 버튼.
              포그라운드 서비스 알림은 앱이 지울 수 없고, 채널을 끄는 것만 가능합니다.
              채널을 꺼도 서비스는 계속 돌아 잠금해제 감지는 유지됩니다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHideOngoing"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="상단 'TodoLock 실행 중' 알림 숨기기" />

            <!--
              소리·진동은 채널이 결정하고 앱이 바꿀 수 없어(setSound/setVibrate 는
              Android 8+ 에서 무시됨) 시스템 화면으로 안내합니다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemindSound"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="미리 알림 소리 · 진동 설정" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
