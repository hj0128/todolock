<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 전용 화면. 설정은 SettingsActivity 로 분리했습니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAdd"
            style="@style/Widget.TodoLock.Button.Sky"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="＋ 할 일 추가" />

        <ImageButton
            android:id="@+id/btnCalendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="달력" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="설정" />
    </LinearLayout>

    <!--
      필수 권한이 없을 때만 뜨는 경고. 설정 화면을 열어보지 않은 사람도
      팝업이 왜 안 뜨는지 알 수 있어야 하므로 목록 화면에 둡니다.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorErrorContainer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnErrorContainer" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:alpha="0.55"
        android:text="할 일이 없습니다.\n오늘 할 일이 없으면 잠금해제 시 팝업도 뜨지 않아요."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>
