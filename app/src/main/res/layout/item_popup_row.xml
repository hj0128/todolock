<?xml version="1.0" encoding="utf-8"?>
<!--
  잠금해제 팝업 전용 행. 위젯 행(widget_item.xml)과 같은 구조입니다.

  메인 목록의 item_todo.xml 을 재활용하면 체크박스를 숨긴 자리가 비어
  왼쪽에 아무 것도 없는 큰 빈 줄이 됩니다. 팝업은 확인 전용이라
  누를 것이 없으므로, 동그라미를 표시용으로 두고 높이를 줄였습니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp"
        android:src="@drawable/ic_circle_outline"
        app:tint="@color/sky_heading"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pStar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp"
        android:src="@drawable/ic_star"
        app:tint="@color/sky_heading"
        android:contentDescription="중요"
        android:visibility="gone" />
</LinearLayout>
