<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 화면 위젯. RemoteViews 가 지원하는 뷰만 쓸 수 있습니다
  (FrameLayout · LinearLayout · TextView · ImageView · ListView 등. CheckBox 는 불가).

  층 구조 — 헤더 판과 목록 판은 맞닿은 형제이고, 항목 판은 목록 판 안에만 들어갑니다.
  헤더는 위쪽만, 목록은 아래쪽만 둥글게 해서 둘이 하나의 카드처럼 보입니다.

    [헤더 판]  불투명 (설정값 그대로)
    [목록 판]  약간 투명
      [항목 판] 불투명
      [항목 판] 불투명

  각 판의 배경을 ImageView 로 깐 이유: RemoteViews 로는 background 의 알파를
  바꿀 수 없지만 ImageView 는 setImageAlpha 를 지원합니다. 둥근 모서리도 유지됩니다.
  FrameLayout 이 wrap_content 라도 match_parent 자식은 크기가 정해진 뒤 다시
  측정되므로, 배경 ImageView 가 내용 높이에 정확히 맞습니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ───── 헤더 판 ───── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/wHeadBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_head"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"><!--
              헤더는 항목보다 살짝 커야 제목처럼 읽힙니다.
              항목 = padding 5+5dp + 34dp = 44dp, 헤더 = 10+10dp + 30dp = 50dp.
              높이를 직접 주지 않고 padding 으로 벌립니다 — 글꼴 크기 설정을 키우면
              헤더도 같이 늘어나야 글자가 잘리지 않습니다.
            -->

            <TextView
                android:id="@+id/wCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/sky_heading"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_name" />

            <ImageView
                android:id="@+id/wAdd"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="3dp"
                android:src="@drawable/ic_add"
                android:tint="@color/sky_heading"
                android:contentDescription="할 일 추가" />

            <ImageView
                android:id="@+id/wSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:padding="5dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/sky_heading"
                android:contentDescription="위젯 설정" />
        </LinearLayout>
    </FrameLayout>

    <!-- ───── 목록 판 (안에 항목 판만) ───── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/wBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 둘 중 하나만 보이므로 weight 를 나눠 갖지 않습니다 (GONE 은 제외됨) -->
            <TextView
                android:id="@+id/wEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/widget_text_dim"
                android:text="할 일이 없습니다" />

            <ListView
                android:id="@+id/wList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
