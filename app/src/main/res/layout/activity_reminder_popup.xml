<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:rippleColor="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"><!--
          카드를 눌렀을 때 닫히지 않도록 터치를 여기서 소비합니다.
          FrameLayout 은 위쪽 자식이 터치를 처리하지 않으면 아래 형제(스크림)로
          이벤트를 넘기므로, 클릭 불가 상태면 카드를 눌러도 스크림이 받아 닫힙니다.
        -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reminder_heading"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/accentHeading" />

            <TextView
                android:id="@+id/tvText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:alpha="0.65" />

            <!--
              메모 전문. 알림창의 펼친 알림과 같은 내용을 담습니다.
              카드가 화면을 넘길 만큼 길어지지 않도록 줄 수를 막아둡니다.
            -->
            <TextView
                android:id="@+id/tvMemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:alpha="0.85"
                android:maxLines="6"
                android:ellipsize="end"
                android:visibility="gone" />

            <!--
              버튼은 '닫기' 하나뿐입니다.
              여기에 '완료' 를 두면 알림을 확인하려다 잘못 눌러 할 일이 사라집니다.
              완료 처리는 알림창의 '완료' 버튼이나 목록·위젯에서 하면 됩니다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLater"
                style="@style/Widget.TodoLock.Button.Sky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/close" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
