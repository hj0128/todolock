<?xml version="1.0" encoding="utf-8"?>
<!--
  할 일 한 줄. 뒤쪽 목록 판보다 진한 자체 배경을 깔아 층을 구분합니다.
  FrameLayout 이 wrap_content 라도 match_parent 자식은 크기가 정해진 뒤
  다시 측정되므로 배경 ImageView 가 행 높이에 맞습니다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp">

    <ImageView
        android:id="@+id/wItemBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_panel"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/wRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- 완료 전용 탭 영역. 손가락으로 누를 만하게 padding 으로 넓혔습니다. -->
        <ImageView
            android:id="@+id/wCheck"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_circle_outline"
            android:tint="@color/sky_heading"
            android:contentDescription="완료로 표시" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16.5sp"
                android:textColor="@color/widget_text"
                android:maxLines="1"
                android:ellipsize="end" />

            <!--
              기한과 미리 알림은 줄을 나눠 씁니다.
              한 줄에 나란히 두면 시각이 둘 붙어 어느 쪽인지 헷갈리고, 글자 크기를
              키우면 둘 중 하나가 반드시 잘립니다(한 줄에 시각 두 개는 들어가지
              않습니다). 줄을 나누면 어느 크기에서도 둘 다 온전히 보입니다.
              알림 줄은 🔔 로 시작해 기한과 구분됩니다.
            -->
            <TextView
                android:id="@+id/wSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textColor="@color/widget_text_dim"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13.5sp"
                android:textColor="@color/widget_text_dim"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 메모 첫 줄. 없으면 GONE 이라 행 높이는 지금 그대로입니다. -->
            <TextView
                android:id="@+id/wMemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13.5sp"
                android:textColor="@color/widget_text_dim"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 중요 토글. 목록 화면처럼 꺼져 있어도 빈 별로 보여야 눌러서 켤 수 있습니다. -->
        <ImageView
            android:id="@+id/wStar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_border"
            android:tint="@color/sky_heading"
            android:contentDescription="중요 표시" />
    </LinearLayout>
</FrameLayout>
