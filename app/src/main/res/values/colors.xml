<?xml version="1.0" encoding="utf-8"?>
<!--
  하늘색(시안 계열 블루, 색상각 ~200) 기반 Material 3 색 역할.
  라이트/다크 두 벌을 두고 themes.xml / values-night/themes.xml 에서 각각 씁니다.
-->
<resources>

    <!-- ========== 라이트 ==========
         링크·라디오·스위치에 쓰이는 강조색. 버튼과 톤을 맞추려 연하게 낮췄습니다. -->
    <color name="md_primary">#2489B8</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#DCF2FE</color>
    <color name="md_on_primary_container">#1B5673</color>

    <color name="md_secondary">#4E616D</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#D1E5F4</color>
    <color name="md_on_secondary_container">#0A1E28</color>

    <color name="md_tertiary">#5F5B7D</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#E5DEFF</color>
    <color name="md_on_tertiary_container">#1B1736</color>

    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <color name="md_background">#F4FBFF</color>
    <color name="md_on_background">#2C3A42</color>
    <color name="md_surface">#F4FBFF</color>
    <color name="md_on_surface">#2C3A42</color>
    <color name="md_surface_variant">#E3EEF5</color>
    <color name="md_on_surface_variant">#5A6B75</color>
    <color name="md_outline">#9BB0BC</color>
    <color name="md_outline_variant">#D3E2EB</color>
    <color name="md_inverse_surface">#2E3133</color>
    <color name="md_inverse_on_surface">#EFF1F3</color>
    <color name="md_inverse_primary">#83CFFF</color>

    <!-- 시트·카드 배경에 쓰이는 표면 단계 -->
    <color name="md_surface_dim">#DDEBF4</color>
    <color name="md_surface_bright">#FBFDFF</color>
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F9FCFF</color>
    <color name="md_surface_container">#EFF8FE</color>
    <color name="md_surface_container_high">#E7F4FD</color>
    <color name="md_surface_container_highest">#DEEFFB</color>

    <!-- ========== 다크 ==========
         라이트와 같은 정도로 대비를 낮춘 값입니다. 강조색은 채도를 눕혀
         어두운 배경에서 형광처럼 튀지 않게 했습니다. -->
    <color name="md_primary_dark">#7FC2E0</color>
    <color name="md_on_primary_dark">#0E2C3A</color>
    <color name="md_primary_container_dark">#2A4E60</color>
    <color name="md_on_primary_container_dark">#C6E6F5</color>

    <color name="md_secondary_dark">#B5C9D7</color>
    <color name="md_on_secondary_dark">#20333D</color>
    <color name="md_secondary_container_dark">#364954</color>
    <color name="md_on_secondary_container_dark">#D1E5F4</color>

    <color name="md_tertiary_dark">#C8C2EA</color>
    <color name="md_on_tertiary_dark">#302D4C</color>
    <color name="md_tertiary_container_dark">#474364</color>
    <color name="md_on_tertiary_container_dark">#E5DEFF</color>

    <color name="md_error_dark">#FFB4AB</color>
    <color name="md_on_error_dark">#690005</color>
    <color name="md_error_container_dark">#93000A</color>
    <color name="md_on_error_container_dark">#FFDAD6</color>

    <color name="md_background_dark">#151B1F</color>
    <color name="md_on_background_dark">#C9D4DA</color>
    <color name="md_surface_dark">#151B1F</color>
    <color name="md_on_surface_dark">#C9D4DA</color>
    <color name="md_surface_variant_dark">#39454C</color>
    <color name="md_on_surface_variant_dark">#9FB0B9</color>
    <color name="md_outline_dark">#6E7F88</color>
    <color name="md_outline_variant_dark">#33404A</color>
    <color name="md_inverse_surface_dark">#DFE3E6</color>
    <color name="md_inverse_on_surface_dark">#2E3133</color>
    <color name="md_inverse_primary_dark">#00658E</color>

    <color name="md_surface_dim_dark">#151B1F</color>
    <color name="md_surface_bright_dark">#333F45</color>
    <color name="md_surface_container_lowest_dark">#10161A</color>
    <color name="md_surface_container_low_dark">#1A2226</color>
    <color name="md_surface_container_dark">#1E272B</color>
    <color name="md_surface_container_high_dark">#263135</color>
    <color name="md_surface_container_highest_dark">#2E3B41</color>

    <!--
      큰 면적(채워진 버튼 · 상태바)에 쓰는 파스텔 하늘색.
      글자색도 진한 남색이 아니라 중간 톤 블루로 두어 대비를 3.4:1 로 낮췄습니다.
      (부드러운 느낌을 위한 의도된 선택이며, WCAG AA 본문 기준 4.5:1 아래입니다)
    -->
    <!--
      진한 하늘파랑. 파스텔(#B3E5FC)은 흰 배경과 구분이 안 돼 버튼이 작아 보였습니다.
      글자는 중간 톤 남청색으로 얹어 대비를 3.3:1 로 낮게 유지합니다.
    -->
    <color name="sky_bright">#4FBDE8</color>
    <color name="on_sky_bright">#1B5D7A</color>
    <!-- 위젯 헤더·목록 판 배경 (0번 팔레트) -->
    <color name="sky_panel">#EAF6FE</color>

    <!--
      ========== 강조색 팔레트 16색 ==========
      설정에서 색상표로 고릅니다(ThemeConfig). 색상만 다르고 밝기·채도 관계는
      하늘색에서 뽑은 값을 그대로 씁니다 — 손으로 찍으면 색마다 밝기가 들쭉날쭉해
      어떤 색은 글자가 안 보이고 어떤 색은 눈이 아픕니다.
      bright(넓은 면적) · on(그 위 글자) · stroke(외곽선) · heading(제목·아이콘)
      · panel(위젯 판). 0번 하늘색만 손으로 다듬은 기존 값을 그대로 씁니다.
      다크 모드 값은 values-night/colors.xml 에 같은 이름으로 있습니다.
    -->
    <!-- 0 하늘 -->
    <color name="p0_bright">@color/sky_bright</color>
    <color name="p0_on">@color/on_sky_bright</color>
    <color name="p0_stroke">@color/sky_stroke</color>
    <color name="p0_heading">@color/sky_heading</color>
    <color name="p0_panel">@color/sky_panel</color>

    <!-- 1 파랑 -->
    <color name="p1_bright">#5488E3</color>
    <color name="p1_on">#1B3D79</color>
    <color name="p1_stroke">#81A7E9</color>
    <color name="p1_heading">#2E62BD</color>
    <color name="p1_panel">#ECF2FD</color>

    <!-- 2 남색 -->
    <color name="p2_bright">#5459E3</color>
    <color name="p2_on">#1B1E79</color>
    <color name="p2_stroke">#8185E9</color>
    <color name="p2_heading">#2E33BD</color>
    <color name="p2_panel">#ECEDFD</color>

    <!-- 3 보라 -->
    <color name="p3_bright">#8854E3</color>
    <color name="p3_on">#3D1B79</color>
    <color name="p3_stroke">#A781E9</color>
    <color name="p3_heading">#622EBD</color>
    <color name="p3_panel">#F2ECFD</color>

    <!-- 4 자주 -->
    <color name="p4_bright">#C754E3</color>
    <color name="p4_on">#661B79</color>
    <color name="p4_stroke">#D481E9</color>
    <color name="p4_heading">#A02EBD</color>
    <color name="p4_panel">#FAECFD</color>

    <!-- 5 분홍 -->
    <color name="p5_bright">#E354B8</color>
    <color name="p5_on">#791B5D</color>
    <color name="p5_stroke">#E981CA</color>
    <color name="p5_heading">#BD2E92</color>
    <color name="p5_panel">#FDECF8</color>

    <!-- 6 장미 -->
    <color name="p6_bright">#E35484</color>
    <color name="p6_on">#791B3A</color>
    <color name="p6_stroke">#E981A4</color>
    <color name="p6_heading">#BD2E5D</color>
    <color name="p6_panel">#FDECF2</color>

    <!-- 7 빨강 -->
    <color name="p7_bright">#E35459</color>
    <color name="p7_on">#791B1E</color>
    <color name="p7_stroke">#E98185</color>
    <color name="p7_heading">#BD2E33</color>
    <color name="p7_panel">#FDECED</color>

    <!-- 8 주황 -->
    <color name="p8_bright">#E38854</color>
    <color name="p8_on">#793D1B</color>
    <color name="p8_stroke">#E9A781</color>
    <color name="p8_heading">#BD622E</color>
    <color name="p8_panel">#FDF2EC</color>

    <!-- 9 호박 -->
    <color name="p9_bright">#E3AA54</color>
    <color name="p9_on">#79531B</color>
    <color name="p9_stroke">#E9BF81</color>
    <color name="p9_heading">#BD842E</color>
    <color name="p9_panel">#FDF7EC</color>

    <!-- 10 노랑 -->
    <color name="p10_bright">#E3C754</color>
    <color name="p10_on">#79661B</color>
    <color name="p10_stroke">#E9D481</color>
    <color name="p10_heading">#BDA02E</color>
    <color name="p10_panel">#FDFAEC</color>

    <!-- 11 라임 -->
    <color name="p11_bright">#B3E354</color>
    <color name="p11_on">#5A791B</color>
    <color name="p11_stroke">#C6E981</color>
    <color name="p11_heading">#8DBD2E</color>
    <color name="p11_panel">#F8FDEC</color>

    <!-- 12 초록 -->
    <color name="p12_bright">#54E36C</color>
    <color name="p12_on">#1B792A</color>
    <color name="p12_stroke">#81E993</color>
    <color name="p12_heading">#2EBD46</color>
    <color name="p12_panel">#ECFDEF</color>

    <!-- 13 에메랄드 -->
    <color name="p13_bright">#54E3B3</color>
    <color name="p13_on">#1B795A</color>
    <color name="p13_stroke">#81E9C6</color>
    <color name="p13_heading">#2EBD8D</color>
    <color name="p13_panel">#ECFDF8</color>

    <!-- 14 청록 -->
    <color name="p14_bright">#54E3DE</color>
    <color name="p14_on">#1B7976</color>
    <color name="p14_stroke">#81E9E5</color>
    <color name="p14_heading">#2EBDB8</color>
    <color name="p14_panel">#ECFDFD</color>

    <!-- 15 회색 -->
    <color name="p15_bright">#919CA6</color>
    <color name="p15_on">#434A51</color>
    <color name="p15_stroke">#ADB5BD</color>
    <color name="p15_heading">#6B7580</color>
    <color name="p15_panel">#F3F5F6</color>

    <!-- 외곽선 버튼(기한 설정 · 미리 알림)의 선 색. 회색이 아닌 하늘색 계열. -->
    <color name="sky_stroke">#7FC9EC</color>

    <!--
      팝업의 '잠깐!' 강조 문구. 같은 하늘색 계열이면서 28sp 큰 글자로 읽히는 선입니다.
      파스텔(#B3E5FC)을 그대로 쓰면 연한 카드 배경에 묻혀 거의 안 보입니다.
    -->
    <color name="sky_heading">#2E8FBF</color>

    <!-- 기한 지난 항목 표시색. 파스텔 팔레트에 맞춰 톤을 낮춘 붉은 계열. -->
    <color name="overdue">#D2726B</color>

    <!--
      홈 화면 위젯용. 위젯은 앱 테마를 물려받지 못해 ?attr 을 쓸 수 없으므로
      명시적인 색이 필요합니다. 다크는 values-night 에서 같은 이름으로 대체됩니다.
    -->
    <!-- 팝업 항목칸. 카드보다 밝아 위에 얹힌 것으로 읽힙니다(둘 다 불투명). -->
    <color name="popup_item_bg">#FBFDFF</color>

    <color name="widget_bg">#EAF6FE</color>
    <!--
      위젯 항목 판. 팝업 항목칸과 같은 값을 참조합니다 — 두 화면의 '할 일 한 줄'이
      같은 색이어야 같은 물건으로 읽힙니다. 다크 대체값도 참조를 따라갑니다.
    -->
    <color name="widget_item_bg">@color/popup_item_bg</color>
    <color name="widget_text">#2C3A42</color>
    <color name="widget_text_dim">#5A6B75</color>
</resources>
