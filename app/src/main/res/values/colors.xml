    <color name="md_surface_container_high">#E7F4FD</color>
    <color name="md_surface_container_highest">#DEEFFB</color>

    <!-- ========== 다크 ==========
         라이트와 같은 정도로 대비를 낮춘 값입니다. 강조색은 채도를 눕혀
         어두운 배경에서 형광처럼 튀지 않게 했습니다. -->
    <color name="md_primary_dark">#7FC2E0</color>
    <color name="md_on_primary_dark">#0E2C3A</color>
    <color name="md_primary_container_dark">#2A4E60</color>
    <color name="md_on_primary_container_dark">#C6E6F5</color>

    <color name="md_secondary_dark">#B5C9D7</color>
