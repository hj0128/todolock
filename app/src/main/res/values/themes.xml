<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      하늘색 Material 3 테마 (라이트).
      다크 모드용 같은 이름의 테마는 values-night/themes.xml 에 있습니다.
    -->
    <style name="Theme.TodoLock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!--
          강조색 기본값(하늘색). 설정에서 다른 팔레트를 고르면 액티비티에
          ThemeOverlay.TodoLock.* 을 얹어 이 네 값만 갈아끼웁니다.
        -->
        <item name="accentFill">@color/sky_bright</item>
        <item name="onAccentFill">@color/on_sky_bright</item>
        <item name="accentStroke">@color/sky_stroke</item>
        <item name="accentHeading">@color/sky_heading</item>

        <!-- 넓은 면적은 밝은 강조색으로. 배경이 밝아지므로 상태바 아이콘은 어둡게. -->
        <item name="android:statusBarColor">?attr/accentFill</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
    </style>

    <!--
      팔레트 오버레이. 액티비티에서 setTheme 으로 얹습니다(ThemeConfig.apply).
      가리키는 색 이름에 values-night 대응이 있어 다크 모드는 저절로 따라갑니다.
      colorPrimary 까지 바꾸는 이유: 라디오·스위치·링크가 그 값을 쓰기 때문에
      강조색만 바꾸면 그것들만 하늘색으로 남아 어긋나 보입니다.
    -->
    <style name="ThemeOverlay.TodoLock.Green" parent="">
        <item name="accentFill">@color/green_bright</item>
        <item name="onAccentFill">@color/on_green_bright</item>
        <item name="accentStroke">@color/green_stroke</item>
        <item name="accentHeading">@color/green_heading</item>
        <item name="colorPrimary">@color/green_heading</item>
    </style>

    <style name="ThemeOverlay.TodoLock.Purple" parent="">
        <item name="accentFill">@color/purple_bright</item>
        <item name="onAccentFill">@color/on_purple_bright</item>
        <item name="accentStroke">@color/purple_stroke</item>
        <item name="accentHeading">@color/purple_heading</item>
        <item name="colorPrimary">@color/purple_heading</item>
    </style>

    <style name="ThemeOverlay.TodoLock.Orange" parent="">
        <item name="accentFill">@color/orange_bright</item>
        <item name="onAccentFill">@color/on_orange_bright</item>
        <item name="accentStroke">@color/orange_stroke</item>
        <item name="accentHeading">@color/orange_heading</item>
        <item name="colorPrimary">@color/orange_heading</item>
    </style>

    <!--
      채워진 버튼: 밝은 하늘색 배경 + 진한 남색 글자 (대비 6.6:1).
      colorPrimary 를 그대로 쓰면 어두워지므로 이 스타일로 분리했습니다.
    -->
    <style name="Widget.TodoLock.Button.Sky" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/accentFill</item>
        <item name="android:textColor">?attr/onAccentFill</item>
        <item name="iconTint">?attr/onAccentFill</item>
        <item name="rippleColor">?attr/onAccentFill</item>
    </style>

    <!-- 외곽선 버튼: 기본값은 회색(colorOutline)이라 강조색 선으로 바꿉니다 -->
    <style name="Widget.TodoLock.Button.SkyOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/accentStroke</item>
        <item name="android:textColor">?attr/accentHeading</item>
        <item name="rippleColor">?attr/accentHeading</item>
    </style>

    <style name="Theme.TodoLock.Popup" parent="Theme.TodoLock">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
