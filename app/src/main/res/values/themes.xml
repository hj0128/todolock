    <!--
      채워진 버튼: 밝은 하늘색 배경 + 진한 남색 글자 (대비 6.6:1).
      colorPrimary 를 그대로 쓰면 어두워지므로 이 스타일로 분리했습니다.
    -->
    <style name="Widget.TodoLock.Button.Sky" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/accentFill</item>
        <item name="android:textColor">?attr/onAccentFill</item>
        <item name="iconTint">?attr/onAccentFill</item>
        <item name="rippleColor">?attr/onAccentFill</item>
    </style>

    <!-- 외곽선 버튼: 기본값은 회색(colorOutline)이라 강조색 선으로 바꿉니다 -->
    <style name="Widget.TodoLock.Button.SkyOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/accentStroke</item>
        <item name="android:textColor">?attr/accentHeading</item>
        <item name="rippleColor">?attr/accentHeading</item>
    </style>

    <!--
      달력의 요일 머리글 한 칸. 일곱 개가 폭을 고르게 나눠 가져야 아래 날짜 칸과
      세로줄이 맞으므로, 폭·무게까지 스타일에 넣어 일곱 번 되풀이하지 않습니다.
    -->
    <style name="TextAppearance.TodoLock.Weekday" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- 위젯 달력의 요일 머리글 한 칸. 일곱 개가 폭을 고르게 나눠 갖습니다. -->
    <style name="TextAppearance.TodoLock.WidgetWeekday" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/widget_text_dim</item>
    </style>

    <!--
      위젯 달력의 날짜 한 칸.

      두 줄로 고정합니다 — 아랫줄은 점 자리라, 점이 없는 날에도 자리를 차지해야
      날짜 숫자가 칸마다 같은 높이에 놓입니다.
    -->
    <style name="TextAppearance.TodoLock.WidgetDay" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:lines">2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 위젯 달력의 한 줄. 여섯 줄이 남은 높이를 고르게 나눠 갖습니다. -->
    <style name="Widget.TodoLock.WidgetWeek" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!--
      기한·알림의 달력·시계 대화상자.
      ContextThemeWrapper 는 바탕 테마를 복사한 뒤 이 스타일만 덮으므로,
      ?attr/accentHeading 이 지금 고른 팔레트를 그대로 따라옵니다 — 16색마다
      대화상자 테마를 만들 필요가 없습니다.

      colorAccent 를 쓰는 이유: 달력의 '고른 날' 동그라미와 '오늘' 글자색이
      모두 이 값에서 나옵니다.
    -->
    <style name="Theme.TodoLock.PickerDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">?attr/accentHeading</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.TodoLock.PickerDialogButton</item>
        <!--
          기본 대화상자 테마는 창 너비를 화면의 95% 로 강제합니다(windowMinWidthMinor).
          삼성 기기의 달력 위젯은 그보다 좁은 고정 너비만 채우고 늘어나지 않아,
          강제한 만큼 오른쪽에 빈 여백이 남습니다. 최소 너비 강제를 없애 내용물
          크기에 맞춰 줄어들게 합니다.
        -->
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

    <!--
      대화상자 아래 버튼(시간 추가 · 취소 · 확인).
      글자색을 직접 넣지 않으면 바탕 테마에서 흘러온 값과 섞여 흐릿해집니다.
    -->
    <style name="Widget.TodoLock.PickerDialogButton" parent="android:Widget.DeviceDefault.Button.Borderless.Colored">
        <item name="android:textColor">?attr/accentHeading</item>
    </style>

    <style name="Theme.TodoLock.Popup" parent="Theme.TodoLock">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
